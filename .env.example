# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
DB_FILE=./data/unitech.db

# University display name
UNI_NAME=UniTech Port Harcourt

# Current academic term (drives course registration)
CURRENT_SESSION=2026/2027
CURRENT_SEMESTER=1

# Set to 1 when running behind a reverse proxy / load balancer (Nginx, Render, Fly...)
TRUST_PROXY=0

# "demo" lets students click Pay and get a test receipt.
# Anything else disables it until a real gateway (e.g. Remita / Paystack) is wired in.
PAYMENT_MODE=demo

# Only used by `npm run seed`. If empty, a random password is generated and printed once.
DEMO_PASSWORD=
